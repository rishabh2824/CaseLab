{
	"name": "newfrontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.16.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/inline-critical-css.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run check && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api/schema.d.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"jsdom": "^29.1.1",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@lucide/svelte": "^1.28.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"eventsource-parser": "^3.1.0",
		"jspdf": "^4.2.1",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	}
}
