{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.19.0",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/inline-critical-css.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && npm exec -y --package=typescript@5.9.3 --package=svelte-check@4.7.4 -- svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && npm exec -y --package=typescript@5.9.3 --package=svelte-check@4.7.4 -- svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run check && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"gen:api": "npm exec -y --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 -- openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api/schema.d.ts && biome check --write src/lib/api/schema.d.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@vitest/coverage-v8": "^4.1.10",
		"fast-check": "^4.9.0",
		"jsdom": "^30.0.1",
		"msw": "^2.15.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@lucide/svelte": "^1.28.0",
		"bits-ui": "^2.18.1",
		"eventsource-parser": "^3.1.0",
		"jspdf": "^4.2.1",
		"svelte-sonner": "^1.1.1"
	}
}
