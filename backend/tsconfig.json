{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ES2021", "DOM"],
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["convex/**/*.ts"],
	"exclude": ["convex/_generated"]
}
