{
	"name": "caselab",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "convex dev",
		"dev:web": "vite dev",
		"build": "vite build && node critical-css.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && npm exec -y --package=typescript@5.9.3 --package=svelte-check@4.7.4 -- svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && npm exec -y --package=typescript@5.9.3 --package=svelte-check@4.7.4 -- svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "tsc --noEmit -p convex/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright install && playwright test",
		"test:all": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run test:e2e",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"deploy": "npx @convex-dev/static-hosting deploy --dist build"
	},
	"dependencies": {
		"@auth/core": "^0.41.3",
		"@convex-dev/auth": "^0.0.95",
		"@convex-dev/rate-limiter": "^0.3.2",
		"@convex-dev/static-hosting": "^0.2.1",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@lucide/svelte": "^1.31.0",
		"@mmailaender/convex-auth-svelte": "^0.1.3",
		"bits-ui": "^2.18.1",
		"convex": "^1.44.0",
		"convex-svelte": "^0.14.0",
		"jspdf": "^4.2.1",
		"svelte-sonner": "^1.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@edge-runtime/vm": "^5.0.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.4",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"convex-test": "^0.0.55",
		"fast-check": "^4.9.0",
		"jsdom": "^30.0.1",
		"msw": "^2.15.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
}
