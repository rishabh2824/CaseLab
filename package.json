{
	"name": "caselab",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "convex dev",
		"dev:web": "vite dev",
		"build": "vite build && node critical-css.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && npm exec -y --package=typescript@6.0.3 --package=svelte-check@4.7.4 -- svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && npm exec -y --package=typescript@6.0.3 --package=svelte-check@4.7.4 -- svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "tsc --noEmit -p convex/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright install && playwright test",
		"test:all": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run test:e2e",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"deploy": "npx @convex-dev/static-hosting deploy --dist build"
	},
	"dependencies": {
		"@convex-dev/better-auth": ">=0.12.5",
		"@convex-dev/rate-limiter": ">=0.4.0",
		"@convex-dev/static-hosting": ">=0.2.1",
		"@fontsource/ibm-plex-sans": ">=5.3.0",
		"@fontsource/space-grotesk": ">=5.3.0",
		"@lucide/svelte": ">=1.47.0",
		"@mmailaender/convex-better-auth-svelte": ">=0.8.2",
		"better-auth": ">=1.6.11 <1.7.0",
		"bits-ui": ">=2.19.2",
		"convex": ">=1.46.0",
		"convex-svelte": ">=0.14.0",
		"jspdf": ">=4.2.1",
		"svelte-sonner": ">=1.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": ">=2.5.14",
		"@edge-runtime/vm": ">=5.0.0",
		"@playwright/test": ">=1.63.0",
		"@sveltejs/adapter-static": ">=3.0.10",
		"@sveltejs/kit": ">=2.70.3",
		"@sveltejs/vite-plugin-svelte": ">=7.3.0",
		"@tailwindcss/vite": ">=4.3.3",
		"@testing-library/jest-dom": ">=7.0.1",
		"@testing-library/svelte": ">=5.4.2",
		"@testing-library/user-event": ">=14.6.7",
		"@types/jsdom": ">=30.0.0",
		"@types/node": ">=26.6.2",
		"@vitest/coverage-v8": ">=5.0.1",
		"convex-test": ">=0.0.59",
		"fast-check": ">=4.10.2",
		"jsdom": ">=30.1.0",
		"msw": ">=2.15.0",
		"svelte": ">=5.57.1",
		"svelte-check": ">=4.7.6",
		"tailwindcss": ">=4.3.3",
		"typescript": ">=7.0.2",
		"vite": ">=8.3.0",
		"vitest": ">=5.0.1"
	}
}
